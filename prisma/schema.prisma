// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication and profile
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  avatar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // OAuth accounts - supports multiple providers per user for account linking
  accounts  Account[]
  templates Template[]

  @@map("users")
}

// OAuth account model - supports multiple providers per user
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // e.g., "google", "github"
  providerId        String   // Provider's user ID
  providerAccountId String   // Alternative name for providerId (some OAuth libs use this)
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?  @db.Text
  sessionState      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Project: Top-level containers for related work
model Project {
  id        String   @id @default(cuid())
  name      String
  color     String?  // Hex color for visual distinction
  userId    String   // Owner of the project
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sections  Section[]

  @@index([userId])
  @@map("projects")
}

// Section: Optional groupings within a project (e.g., "Phase 1", "Backlog")
model Section {
  id        String   @id @default(cuid())
  name      String
  position  Int      // For ordering sections within a project
  projectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, position])
  @@map("sections")
}

// Template: Reusable task structures for recurring workflows
model Template {
  id                  String   @id @default(cuid())
  name                String   // Template name for user reference
  defaultTitle        String   // Default title (may include placeholders)
  defaultDescription  String?  @db.Text // Default description
  defaultPriority     String?  // Priority value (e.g., "MEDIUM", "HIGH")
  defaultTags         String[] // Array of tag names to apply
  subtaskTemplates    Json?    // JSON array of subtask templates
  userId              String   // Templates are user-specific
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("templates")
}
