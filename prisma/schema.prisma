generator client {
  provider   = "prisma-client-js"
  output     = "../src/platform/db/generated"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email       String      @unique
  name        String?
  avatar      String?
  theme       Theme       @default(SYSTEM)
  defaultView DefaultView @default(KANBAN)

  defaultProjectId String?
  defaultProject   Project? @relation("DefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)

  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  collaborations Collaboration[]
  shareLinks     ShareLink[]
  tasks          Task[]

  @@map("users")
}

enum AccountProvider {
  GOOGLE
  GITHUB
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum DefaultView {
  LIST
  KANBAN
}

model Account {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider     AccountProvider
  providerId   String
  accessToken  String?         @db.Text
  refreshToken String?         @db.Text
  expiresAt    DateTime?
  tokenType    String?
  scope        String?
  idToken      String?         @db.Text
  sessionState String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  color       String?
  defaultView DefaultView @default(KANBAN)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  collaborations  Collaboration[]
  shareLinks      ShareLink[]
  tasks           Task[]
  tags            Tag[]
  defaultForUsers User[]          @relation("DefaultProject")

  @@index([userId])
  @@map("projects")
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String       @db.VarChar(500)
  description String?      @db.Text
  dueDate     DateTime?
  priority    TaskPriority @default(NONE)
  status      TaskStatus   @default(TODO)
  position    Int
  isTemplate  Boolean      @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  subtasks Subtask[]
  tags     Tag[]

  @@index([userId])
  @@index([projectId])
  @@index([projectId, position])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title      String  @db.VarChar(500)
  completed  Boolean @default(false)
  position   Int
  isTemplate Boolean @default(false)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, position])
  @@map("subtasks")
}

model Tag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String
  color String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([name, projectId])
  @@index([name])
  @@index([projectId])
  @@map("tags")
}

model ShareLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token     String    @unique
  password  String?
  expiresAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("share_links")
}

enum CollaborationRole {
  VIEWER
  EDITOR
  ADMIN
}

model Collaboration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role CollaborationRole @default(VIEWER)

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("collaborations")
}
