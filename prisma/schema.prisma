// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication and profile
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OAuth accounts - supports multiple providers per user for account linking
  accounts Account[]
  tasks    Task[]

  @@map("users")
}

// OAuth account model - supports multiple providers per user
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // e.g., "google", "github"
  providerId        String   // Provider's user ID
  providerAccountId String   // Alternative name for providerId (some OAuth libs use this)
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?  @db.Text
  sessionState      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Project: Top-level containers for related work
model Project {
  id        String   @id @default(cuid())
  name      String
  color     String?  // Hex color for visual distinction
  userId    String   // Owner of the project
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sections  Section[]
  tasks     Task[]

  @@index([userId])
  @@map("projects")
}

// Section: Optional groupings within a project (e.g., "Phase 1", "Backlog")
model Section {
  id        String   @id @default(cuid())
  name      String
  position  Int      // For ordering sections within a project
  projectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
  @@index([projectId, position])
  @@map("sections")
}

// Priority levels for tasks
enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Task status
enum Status {
  TODO
  IN_PROGRESS
  DONE
}

// Task: Primary work items
model Task {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(500)
  description String?   @db.Text
  dueDate     DateTime?
  priority    Priority  @default(NONE)
  status      Status    @default(TODO)
  position    Int       // For ordering tasks within a section or project
  sectionId   String?
  projectId   String
  userId      String    // Owner of the task
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subtasks  Subtask[]

  @@index([userId])
  @@index([projectId])
  @@index([sectionId])
  @@index([projectId, position])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

// Subtask: Checklist-style items nested under a task (single level)
model Subtask {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(500)
  completed Boolean  @default(false)
  position  Int      // For ordering subtasks within a task
  taskId    String

  // Relations
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, position])
  @@map("subtasks")
}
